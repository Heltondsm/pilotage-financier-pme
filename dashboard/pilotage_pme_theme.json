  "foreground": "#1B1B1B",
  "foregroundNeutralSecondary": "#737373",
  "background": "#FFFFFF",
  "tableAccent": "#2171B5",
  "good": "#08306B",
  "neutral": "#737373",
  "bad": "#A50F15",
  "textClasses": {
    "callout": {"fontSize": 40, "fontFace": "Segoe UI Bold", "color": "#08306B"},
    "title": {"fontSize": 20, "fontFace": "Segoe UI Semibold", "color": "#08306B"},
    "header": {"fontSize": 15, "fontFace": "Segoe UI Semibold", "color": "#08306B"},
    "label": {"fontSize": 15, "fontFace": "Segoe UI", "color": "#1B1B1B"}
  },
  "visualStyles": {
